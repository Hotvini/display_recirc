{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build",
      "command": "build",
      "preset": "debug",
      "targets": [
        "all"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template build task"
    },
    {
      "type": "cmake",
      "label": "CMake: clean",
      "command": "clean",
      "preset": "debug",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template clean task"
    },
    {
      "type": "cmake",
      "label": "CMake: configure",
      "command": "configure",
      "preset": "debug",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake template configure task"
    },
    {
      "type": "shell",
      "label": "CMake: build",
      "command": "cmake --build --preset debug",
      "options": {
        "cwd": "${workspaceFolder}/armgcc"
      },
      "dependsOn": "CMake: configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Configure + build using armgcc debug preset"
    },
    {
      "type": "shell",
      "label": "CMake: clean",
      "command": "cmake --build --preset debug --target clean",
      "options": {
        "cwd": "${workspaceFolder}/armgcc"
      },
      "dependsOn": "CMake: configure",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Clean using armgcc debug preset"
    },
    {
      "type": "shell",
      "label": "CMake: configure",
      "command": "cmake --preset debug",
      "options": {
        "cwd": "${workspaceFolder}/armgcc"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Configure using armgcc debug preset"
    }
  ]
}